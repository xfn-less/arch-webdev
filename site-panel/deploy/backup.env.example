# Copy to /etc/site-panel/backup.env and fill in.
# chmod 600 /etc/site-panel/backup.env

# age public key for encrypting uploads (private key stays in AGE_IDENTITY)
AGE_RECIPIENT=age1replace_me
AGE_IDENTITY=/etc/site-panel/age.key

# rclone remote + bucket created for Site Panel backups
# Example after: rclone config  → name "r2", type amazon s3, provider Cloudflare
RCLONE_REMOTE=r2:site-panel

PANEL_HOME=/var/lib/site-panel
INCLUDE_TASKS=0

# Retention: config 12h hourly; site packs 3 daily. No weekly force.
KEEP_HOURLY=12
KEEP_DAILY=3
