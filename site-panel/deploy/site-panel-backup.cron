# Install:
#   cp deploy/site-panel-backup.cron /etc/cron.d/site-panel-backup
#   chmod 644 /etc/cron.d/site-panel-backup
# Requires /etc/site-panel/backup.env and rclone+age configured.
#
# Policy: no weekly force.
#   meta  — every hour, keep 12 hourly (skip if unchanged)
#   sites — daily, per-site packs, keep 3 daily (skip unchanged sites)

SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Meta every hour (skips when unchanged)
5 * * * * root KIND=meta /usr/local/libexec/site-panel-backup >>/var/log/site-panel-backup.log 2>&1

# Sites once a day 03:15 UTC — only changed sites upload
15 3 * * * root KIND=sites /usr/local/libexec/site-panel-backup >>/var/log/site-panel-backup.log 2>&1
